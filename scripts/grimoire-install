#!/usr/bin/env bash
# grimoire-install — install grimoire content to AI assistant config directories.
# Normally invoked via `./grimoire.sh install` at the repo root; runnable directly too.
#
# Usage:
#   ./grimoire.sh install             Install to targets listed in local/config.toml.
#   ./grimoire.sh install claude      Install a specific target (must exist in registry.toml).
#   ./grimoire.sh install --all       Install every target listed in local/config.toml.
#   ./grimoire.sh install --dry-run   Preview without writing or stowing.
#   ./grimoire.sh install --no-prune  Don't remove orphan symlinks created by previous installs.

set -euo pipefail
# shellcheck source=_grimoire-lib.sh
source "$(dirname -- "$0")/_grimoire-lib.sh"

TEMP_ARTIFACT_DIR=""

# ── Plan ───────────────────────────────────────────────────────────────────

# Print the target-agnostic plan: the global (self + local) items shared by every
# target. Skip and override notices for this global stack are reported once here
# (on stderr, via resolve_items' notify mode).
print_plan() {
  printf '%s── plan ──%s\n' "$C_BOLD" "$C_RESET"
  local kind items name path origin
  for kind in "${KINDS[@]}"; do
    items=$(resolve_items "$kind" "" 1)
    [[ -z "$items" ]] && continue
    while IFS=$'\t' read -r name path origin; do
      [[ -z "$name" ]] && continue
      printf '  %-10s %-32s %sfrom %s%s\n' "$kind" "$name" "$C_DIM" "$origin" "$C_RESET"
    done <<< "$items"
  done
}

# ── Filesystem ops ─────────────────────────────────────────────────────────

require_stow() {
  command -v stow >/dev/null 2>&1 || die "GNU Stow is required but was not found in PATH"
}

cleanup_temp_artifact() {
  [[ -n "$TEMP_ARTIFACT_DIR" ]] && rm -rf -- "$TEMP_ARTIFACT_DIR"
}

prepare_artifact_root() {
  local artifact=$1
  mkdir -p -- "$artifact" || die "cannot create artifact dir: $artifact"
}

prepare_target_artifact() {
  local target_artifact=$1 dry=$2 name=$3
  if [[ "$dry" == 0 ]]; then
    [[ "$target_artifact" == "$STOW_ARTIFACT_DIR/$name" ]] ||
      die "refusing to clear unexpected target artifact dir: $target_artifact"
    rm -rf -- "$target_artifact"
  fi
  mkdir -p -- "$target_artifact" || die "cannot create target artifact dir: $target_artifact"
}

materialize_item() {
  local src=$1 dst=$2 dst_dir
  if [[ -d "$src" && ! -L "$src" ]]; then
    mkdir -p -- "$dst" || die "cannot create artifact item: $dst"
    cp -R -- "$src"/. "$dst"/ || die "cannot materialize item: $src"
  else
    dst_dir=$(dirname -- "$dst")
    mkdir -p -- "$dst_dir" || die "cannot create artifact directory: $dst_dir"
    cp -R -- "$src" "$dst" || die "cannot materialize item: $src"
  fi
}

prepare_stow_destination() {
  # Prints one of: replace, would-stow, stowed
  local dst=$1 dry=$2 mode=$3
  if [[ "$mode" == "agents-md" ]]; then
    if [[ -e "$dst" && ! -L "$dst" && -d "$dst" ]]; then
      die "refusing to overwrite directory: $dst"
    fi
    if [[ -L "$dst" || -e "$dst" ]]; then
      if [[ "$dry" == 1 ]]; then
        printf 'would-stow'; return 0
      fi
      rm -- "$dst"
    fi
    if [[ "$dry" == 1 ]]; then
      printf 'would-stow'
    else
      printf 'stowed'
    fi
    return 0
  fi

  if [[ -L "$dst" ]]; then
    if [[ "$dry" == 1 ]]; then
      printf 'replace'; return 0
    fi
    rm -- "$dst"
  elif [[ -e "$dst" ]]; then
    die "refusing to overwrite non-symlink: $dst"
  fi
  if [[ "$dry" == 1 ]]; then
    printf 'would-stow'
  else
    printf 'stowed'
  fi
}

run_stow() {
  local stow_dir=$1 target_dir=$2 package=$3 dry=$4
  [[ "$dry" == 1 ]] && return 0
  mkdir -p -- "$target_dir" || die "cannot create target directory: $target_dir"
  stow -d "$stow_dir" -t "$target_dir" "$package" >/dev/null ||
    die "stow failed for package '$package' into $target_dir"
}

render_agents_md() {
  # Concatenate $1 (source) + the local overlay $3 (if present) into $2 (output).
  # The local overlay mirrors the target's agents_md filename, so `claude` picks
  # up local/CLAUDE.md while `codex` picks up local/AGENTS.md.
  # Ensures a "\n\n" separator unless the base already ends with one.
  local src=$1 out=$2 local_overlay=$3 last
  : > "$out"
  [[ -f "$src" ]] && cat -- "$src" >> "$out"
  if [[ -f "$local_overlay" ]]; then
    last=$(tail -c 2 -- "$out" 2>/dev/null; printf X)
    last="${last%X}"
    [[ "$last" != $'\n\n' ]] && printf '\n\n' >> "$out"
    cat -- "$local_overlay" >> "$out"
  fi
}

install_target() {
  local name=$1 dry=$2 prune=$3 artifact_base=$4
  local root_raw root_expanded agents_md_name
  local target_artifact="$artifact_base/$name"
  prepare_target_artifact "$target_artifact" "$dry" "$name"
  root_raw=$(target_field "$name" root)
  root_expanded=$(expand_path "$root_raw")
  printf '\n%s── %s ──%s %s%s%s\n' "$C_BOLD" "$name" "$C_RESET" "$C_DIM" "$root_raw" "$C_RESET"

  agents_md_name=$(target_field "$name" agents_md)
  if [[ -n "$agents_md_name" ]]; then
    local src="$ROOT/$agents_md_name"
    local dst="$root_expanded/$agents_md_name"
    if [[ ! -f "$src" ]]; then
      printf '  %s!%s agents-md %s missing from repo root — skipping\n' \
        "$C_YELLOW" "$C_RESET" "$agents_md_name"
    else
      local package_dir="$target_artifact/agents-md" status
      mkdir -p -- "$package_dir" || die "cannot create artifact package: $package_dir"
      render_agents_md "$src" "$package_dir/$agents_md_name" "$LOCAL_DIR/$agents_md_name"
      status=$(prepare_stow_destination "$dst" "$dry" agents-md)
      run_stow "$target_artifact" "$root_expanded" agents-md "$dry"
      printf '  %sagents-md%s %s %s(%s)%s\n' \
        "$C_GREEN" "$C_RESET" "$agents_md_name" "$C_DIM" "$status" "$C_RESET"
    fi
  fi

  local kind kind_rel kind_root status entry entry_target rel keep k pdir package_has_items
  local p_name p_path p_origin items
  local -a kept=() find_depth=()
  for kind in "${KINDS[@]}"; do
    kind_rel=$(target_field "$name" "$kind")
    [[ -z "$kind_rel" ]] && continue
    kind_root=$(target_path "$root_expanded" "$kind_rel")
    kept=()
    package_has_items=0
    items=$(resolve_items "$kind" "$name")
    while IFS=$'\t' read -r p_name p_path p_origin; do
      [[ -z "$p_name" ]] && continue
      kept+=("$p_name")
      materialize_item "$p_path" "$target_artifact/$kind/$p_name"
      status=$(prepare_stow_destination "$kind_root/$p_name" "$dry" item)
      package_has_items=1
      printf '  %s%-20s%s %s %s← %s (%s)%s\n' \
        "$C_CYAN" "$kind" "$C_RESET" "$p_name" "$C_DIM" "$p_origin" "$status" "$C_RESET"
    done <<< "$items"
    if [[ "$package_has_items" == 1 ]]; then
      run_stow "$target_artifact" "$kind_root" "$kind" "$dry"
    fi

    if [[ "$prune" == 1 && -d "$kind_root" ]]; then
      # Skills used to be installed with nested category paths. Keep recursive
      # pruning for that kind so old category links are cleaned up.
      if [[ "$kind" == "skills" ]]; then
        find_depth=()
      else
        find_depth=(-maxdepth 1)
      fi
      while IFS= read -r entry; do
        [[ -z "$entry" ]] && continue
        entry_target=$(link_target_path "$entry")
        [[ -z "$entry_target" ]] && continue
        case "$entry_target" in "$ROOT"/*) : ;; *) continue ;; esac
        rel="${entry#"$kind_root"/}"
        keep=0
        for k in "${kept[@]+"${kept[@]}"}"; do
          [[ "$k" == "$rel" ]] && { keep=1; break; }
        done
        [[ "$keep" == 1 ]] && continue
        if [[ "$dry" == 1 ]]; then
          printf '  %s%-20s%s %s %s(would remove orphan)%s\n' \
            "$C_YELLOW" "prune" "$C_RESET" "$rel" "$C_DIM" "$C_RESET"
        else
          rm -- "$entry"
          printf '  %s%-20s%s %s %s(removed orphan)%s\n' \
            "$C_YELLOW" "prune" "$C_RESET" "$rel" "$C_DIM" "$C_RESET"
          # Walk up rmdir'ing empty parents, stopping before kind_root.
          pdir=$(dirname -- "$entry")
          while [[ "$pdir" != "$kind_root" && "$pdir" != "/" && "$pdir" != "." ]]; do
            rmdir -- "$pdir" 2>/dev/null || break
            pdir=$(dirname -- "$pdir")
          done
        fi
      done < <(find "$kind_root" -mindepth 1 "${find_depth[@]+"${find_depth[@]}"}" -type l 2>/dev/null)
    fi
  done
}

usage() { sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; }

main() {
  local -a chosen=()
  local dry=0 prune=1 all=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)      all=1; shift ;;
      --dry-run)  dry=1; shift ;;
      --no-prune) prune=0; shift ;;
      -h|--help)  usage; exit 0 ;;
      --)         shift; while [[ $# -gt 0 ]]; do chosen+=("$1"); shift; done ;;
      -*)         die "unknown option: $1" ;;
      *)          chosen+=("$1"); shift ;;
    esac
  done

  load_targets_toml "$REGISTRY_FILE"
  load_disabled

  if [[ "$all" == 1 || ${#chosen[@]} -eq 0 ]]; then
    chosen=()
    local t
    while IFS= read -r t; do
      [[ -z "$t" ]] && continue
      chosen+=("$t")
    done < <(load_string_array "$LOCAL_CONFIG" targets)
    if [[ ${#chosen[@]} -eq 0 ]]; then
      die "no targets specified — pass names or set \`targets = [...]\` in local/config.toml"
    fi
  fi

  local known t
  for t in "${chosen[@]}"; do
    if ! target_exists "$t"; then
      known=$(IFS=', '; printf '%s' "${TARGET_NAMES[*]+${TARGET_NAMES[*]}}")
      die "unknown target: $t (known: $known)"
    fi
  done

  require_stow
  local artifact_base
  if [[ "$dry" == 1 ]]; then
    TEMP_ARTIFACT_DIR=$(mktemp -d)
    artifact_base=$TEMP_ARTIFACT_DIR
    trap cleanup_temp_artifact EXIT
  else
    artifact_base=$STOW_ARTIFACT_DIR
  fi
  prepare_artifact_root "$artifact_base"

  print_plan

  [[ "$dry" == 1 ]] && printf '\n%s(dry run — nothing written)%s\n' "$C_DIM" "$C_RESET"
  for t in "${chosen[@]}"; do
    install_target "$t" "$dry" "$prune" "$artifact_base"
  done
  printf '\n'
}

main "$@"
